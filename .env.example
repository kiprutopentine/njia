# Solana RPC endpoint (devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Base58-encoded secret key of the cause/treasury wallet.
# Receives donations and pays for cNFT receipt mints.
# Generate with: pnpm setup:wallet
CAUSE_WALLET_SECRET=

# Public base URL of the deployed app (used to build absolute icon URLs
# and the actions.json mapping). No trailing slash.
# Local dev example: http://localhost:3000
# Prod example: https://njia.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Merkle tree address for compressed NFT receipts.
# Generate with: pnpm setup:tree
CNFT_TREE_ADDRESS=

# Set to "false" to skip cNFT minting (transfer-only mode).
# Useful as a fallback if cNFT tooling has issues during the demo.
ENABLE_CNFT_RECEIPT=true
